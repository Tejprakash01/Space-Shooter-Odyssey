# Backend Environment Configuration
PORT=5000
NODE_ENV=development
GAME_NAME=SPACE SHOOTER ODYSSEY
MONGODB_URI=mongodb://127.0.0.1:27017/space_shooter_odyssey
JWT_SECRET=super_secret_space_shooter_jwt_key_2026
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# ================================
# Ads Management Configuration
# ================================
# Active Ad Provider: simulated_provider | admob | unity | custom
AD_PROVIDER=simulated_provider
ADS_ENABLED=true

# Placement Toggles
AD_REVIVE_ENABLED=true
AD_DOUBLE_SCORE_ENABLED=true
AD_DOUBLE_CREDITS_ENABLED=true
AD_EXTRA_SHIELD_ENABLED=true

# Frequency Caps & Cooldowns
MAX_REWARDED_ADS_PER_DAY=10
MAX_REWARDED_ADS_PER_SESSION=5
MAX_REWARDED_PER_HOUR=8
MIN_SECONDS_BETWEEN_REWARDED_ADS=30
AD_OPPORTUNITY_EXPIRY_SECONDS=120
MAX_REVIVES_PER_MISSION=1

# Ad Network Credentials
# Google AdMob
ADMOB_APP_ID=
ADMOB_REWARDED_AD_UNIT_ID=
ADMOB_SECRET_KEY=

# Unity Ads
UNITY_GAME_ID=
UNITY_PLACEMENT_ID=
UNITY_API_KEY=

# Custom Webhook Provider
CUSTOM_AD_WEBHOOK_URL=
CUSTOM_AD_SECRET=
