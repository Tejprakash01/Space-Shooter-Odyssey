# SPACE SHOOTER ODYSSEY - Master Environment Configuration Template
# Copy this file to .env or configure client/.env and server/.env individually.

# ================================
# Common & Game Identity
# ================================
GAME_NAME=SPACE SHOOTER ODYSSEY
VITE_GAME_NAME=SPACE SHOOTER ODYSSEY

# ================================
# Server Core Configuration
# ================================
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/space_shooter_odyssey
JWT_SECRET=replace_with_strong_production_secret_key_12345
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# ================================
# Ads Management Configuration
# ================================
# Active Ad Provider: simulated_provider | admob | unity | custom
AD_PROVIDER=simulated_provider

# Master Ads Killswitch (true | false)
ADS_ENABLED=true

# Placement Toggles (true | false)
AD_REVIVE_ENABLED=true
AD_DOUBLE_SCORE_ENABLED=true
AD_DOUBLE_CREDITS_ENABLED=true
AD_EXTRA_SHIELD_ENABLED=true

# Limits & Cooldowns
MAX_REWARDED_ADS_PER_DAY=10
MAX_REWARDED_ADS_PER_SESSION=5
MAX_REWARDED_PER_HOUR=8
MIN_SECONDS_BETWEEN_REWARDED_ADS=30
AD_OPPORTUNITY_EXPIRY_SECONDS=120
MAX_REVIVES_PER_MISSION=1

# Provider Credentials (Optional - for production ad networks)
# Google AdMob S2S Verification
ADMOB_APP_ID=
ADMOB_REWARDED_AD_UNIT_ID=
ADMOB_SECRET_KEY=

# Unity Ads Verification
UNITY_GAME_ID=
UNITY_PLACEMENT_ID=
UNITY_API_KEY=

# Custom Webhook Provider
CUSTOM_AD_WEBHOOK_URL=
CUSTOM_AD_SECRET=

# ================================
# Client Configuration
# ================================
# Production: Set to your Render backend URL (e.g. https://space-shooter-api.onrender.com/api)
VITE_API_URL=http://localhost:5000/api
