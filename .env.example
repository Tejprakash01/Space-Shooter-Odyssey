# SPACE SHOOTER ODYSSEY - Master Environment Configuration Template
# Copy this file to .env or configure client/.env and server/.env individually.

# ================================
# Common & Game Identity
# ================================
# Evaluator Note: Changing GAME_NAME and VITE_GAME_NAME updates the game identity dynamically across all client & server layers
GAME_NAME=SPACE SHOOTER ODYSSEY
VITE_GAME_NAME=SPACE SHOOTER ODYSSEY

# ================================
# Server Configuration
# ================================
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/space_shooter_odyssey
JWT_SECRET=replace_with_strong_production_secret_key_12345
JWT_EXPIRES_IN=7d

# ================================
# Client Configuration
# ================================
VITE_API_URL=http://localhost:5000/api

